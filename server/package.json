{
  "name": "@hp/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "seed": "tsx src/db/seed/run.ts",
    "db:reset": "tsx src/db/reset.ts",
    "admin:create": "tsx src/scripts/create-admin.ts",
    "backup": "tsx src/scripts/backup.ts",
    "backup:verify": "tsx src/scripts/verify-backup.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --import ./test/setup.mjs --test test/auth.test.ts test/catalog.test.ts test/addresses.test.ts test/orders.test.ts test/admin.test.ts test/seo.test.ts test/backups.test.ts test/notifications.test.ts test/catalogue-tree.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
