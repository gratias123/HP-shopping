# ---------------------------------------------------------------------------
# HP COLLECTION — variables d'environnement du serveur
# Copier ce fichier vers server/.env (jamais versionné) et renseigner les valeurs.
# ---------------------------------------------------------------------------

# Environnement : development | production | test
NODE_ENV=development

# Port du serveur API
PORT=4000

# Origine publique du frontend (utilisée pour les contrôles CSRF et les liens)
APP_URL=http://localhost:5173

# Secret de signature des sessions (générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
SESSION_SECRET=remplacez-moi-par-un-secret-aleatoire-de-64-caracteres

# Durée de vie d'une session client en jours
SESSION_TTL_DAYS=14

# Durée de vie des sessions staff/admin, en heures (plus courte par sécurité)
ADMIN_SESSION_TTL_HOURS=12

# Mode de stockage des données.
# local = SQLite via node:sqlite (mode pris en charge et testé).
# supabase = migrations SQL fournies, mais connecteur applicatif non branché :
#            l'API refuse volontairement de démarrer dans ce mode.
DATA_MODE=local

# Chemin de la base SQLite locale (relatif au dossier server/)
DATABASE_PATH=./data/hp-collection.sqlite

# Stockage des images uploadées
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Sauvegardes locales : dossier, rétention en jours et nombre minimal conservé.
# Planifier `npm run backup` (cron / tâche planifiée) et vérifier avec
# `npm run backup:verify`. Les archives doivent être copiées hors du serveur.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_KEEP=5

# Devise (ISO 4217) et pays par défaut
# XOF = franc CFA (Bénin). Les montants sont stockés en centimes entiers.
CURRENCY=XOF
DEFAULT_COUNTRY=BJ

# Seuil d'alerte de stock bas dans l'administration
LOW_STOCK_THRESHOLD=5

# ---------------------------------------------------------------------------
# Supabase (uniquement si DATA_MODE=supabase)
# La clé service_role ne doit JAMAIS être exposée côté navigateur.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Paiement mobile — aucune clé n'est fournie. Prévoir FedaPay ou un prestataire
# compatible avec le Bénin (Mobile Money). Tant que ces variables sont vides,
# l'option Mobile Money est désactivée et le serveur refuse ces commandes.
# Le paiement à la livraison (COD) reste disponible.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Stockage Supabase (bucket public pour les visuels produits)
SUPABASE_STORAGE_BUCKET=product-media
